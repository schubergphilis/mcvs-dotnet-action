# The default EditorConfig of the mcvs-dotnet-action.
#
# Copy this file to the root of a project and adjust it where needed. It is the
# configuration of both the 'lint' and the 'static-analysis' testing type, as
# 'dotnet format' and the Roslyn analysers derive their rules and severities
# from it.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,fsproj,props,targets,vbproj}]
indent_size = 2

[*.{cs,vb}]
# Severities have to be at least 'suggestion' to be reported by the linter, as
# 'dotnet format' is run with '--severity info'.
dotnet_analyzer_diagnostic.category-design.severity = suggestion
dotnet_analyzer_diagnostic.category-maintainability.severity = suggestion
dotnet_analyzer_diagnostic.category-naming.severity = suggestion
dotnet_analyzer_diagnostic.category-performance.severity = suggestion
dotnet_analyzer_diagnostic.category-reliability.severity = suggestion
dotnet_analyzer_diagnostic.category-security.severity = warning
dotnet_analyzer_diagnostic.category-usage.severity = suggestion
# Unused code has to be removed rather than suppressed.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped:warning
# Whether 'var' or an explicit type is used is left to the author: the linter
# is run with '--severity info', so anything above 'silent' would turn a style
# preference into a failing build.
csharp_style_var_elsewhere = true:silent
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_using_directive_placement = outside_namespace:warning
